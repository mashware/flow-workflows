{
  "name": "flow-workflows",
  "version": "0.65.0-rc.5",
  "description": "Guided feat/bug workflows (start→ship), post-deploy monitoring and multi-agent code review, stack-agnostic. Each repo uses a shared FLOW.md plus optional harness overlay.",
  "type": "module",
  "bin": {
    "flow-workflows": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "adapters/",
    "plugins/flow/CHANGELOG.md",
    "plugins/flow/.claude-plugin/plugin.json",
    "plugins/flow/examples/FLOW.template.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "workflow",
    "code-review",
    "opencode",
    "gemini-cli",
    "codex",
    "hermes",
    "coding-agent",
    "feature-flow",
    "bug-flow"
  ],
  "author": {
    "name": "Alberto Vioque",
